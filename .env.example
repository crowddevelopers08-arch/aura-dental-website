# ---------------------------------------------------------------------------
# Neon Postgres
#
# Both come from the Neon console > your project > Connection Details.
#   DATABASE_URL  the POOLED host — contains "-pooler". Used by the running app.
#   DIRECT_URL    the DIRECT host — no "-pooler". Used by `prisma migrate` only,
#                 because migrations must not run through PgBouncer.
# Keep `?sslmode=require` on both.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:npg_fIhbiVnUO3s0@ep-ancient-glade-auh3domo-pooler.c-10.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_fIhbiVnUO3s0@ep-ancient-glade-auh3domo.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require"

